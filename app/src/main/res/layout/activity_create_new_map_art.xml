<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@color/light_cream"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/titleTV"
                tools:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                style="@style/Text.ScreenTitle"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/create_new_art" />

        </RelativeLayout>

        <FrameLayout android:id="@+id/mapArtsContainer"
            android:background="@color/dark_d5"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="16dp"
            android:visibility="invisible"
            tools:visibility="visible"
            android:layout_height="200dp" >

        </FrameLayout>

        <Space
            android:id="@+id/stateErrorS"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:visibility="gone"
            tools:visibility="gone"
            />

        <ImageView
            android:id="@+id/errorImageIV"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="56dp"
            android:layout_gravity="center"
            tools:visibility="gone"
            android:src="@drawable/ic_error_general"/>

        <TextView
            android:id="@+id/errorTextTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            tools:visibility="gone"
            style="@style/Text.MiddleScreenInfoText"
            android:textSize="12sp"
            tools:text="It seems like something wrong happened. Please try again" />

        <TextView
            android:id="@+id/cityCountryTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Title"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/mapArtsContainer"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Salvador - Casa" />

        <TextView
            android:id="@+id/latTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.GraySubTitle"
            tools:visibility="visible"
            android:layout_marginHorizontal="16dp"
            tools:text="Latitude: 45.131231231" />

        <TextView
            android:id="@+id/longTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.GraySubTitle"
            tools:visibility="visible"
            android:layout_marginHorizontal="16dp"
            tools:text="Longitude: 45.131231231" />

        <TextView
            android:id="@+id/colorPaletteTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.GraySubTitle"
            tools:visibility="visible"
            android:visibility="gone"
            android:layout_marginHorizontal="16dp"
            tools:text="Paleta de Cores: Java" />

        <TextView
            android:id="@+id/mapLayersTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Title"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="16dp"
            android:layout_marginVertical="8dp"
            tools:visibility="visible"
            android:text="@string/color_legend"
            tools:text="Legenda de cores" />

        <LinearLayout
            android:id="@+id/mapColorsHoldersLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:id="@+id/loadingIndicatorLAV"
            app:lottie_rawRes="@raw/loading_globe"
            app:lottie_loop="true"
            android:visibility="gone"
            tools:visibility="gone"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"/>

        <TextView
            android:id="@+id/loadingMessageTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.GraySubTitle"
            tools:visibility="visible"
            android:visibility="gone"
            android:layout_gravity="center"
            tools:text="Acessando sua localização..." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            />

        <manoellribeiro.dev.martp.core.components.MartpButton
            android:id="@+id/actionMB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/save_art"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cornerRadius="50dp"
            style="@style/MartpButton.Primary"/>

    </LinearLayout>

</ScrollView>

