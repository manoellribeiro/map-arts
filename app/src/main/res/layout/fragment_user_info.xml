<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:context=".scenes.gallery.GalleryFragment"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_cream"
        android:paddingTop="16dp"
        tools:context=".scenes.gallery.GalleryFragment">

        <ImageView
            android:id="@+id/logoIV"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginStart="11dp"
            android:visibility="visible"
            android:src="@drawable/ic_martp_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/digitalExhibitionTV"
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/digital_exhibition"
            android:textSize="18sp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoIV" />

        <TextView
            android:id="@+id/digitalExhibitionDescriptionTV"
            style="@style/Text.GraySubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="@string/digital_exhibition_description"
            android:textSize="14sp"
            android:visibility="visible"
            android:lineSpacingMultiplier="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/digitalExhibitionTV" />

        <manoellribeiro.dev.martp.core.components.MartpTextInput
            android:id="@+id/usernameMTI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:imeOptions="actionNext"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/digitalExhibitionDescriptionTV"
            app:cornerRadius="10dp"
            app:label="@string/username"
            app:placeholder="@string/name_or_nickname_hint" />

        <TextView
            android:id="@+id/usernameDescriptionTV"
            style="@style/Text.GraySubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:lineSpacingMultiplier="0.9"
            android:text="@string/name_suggestion_hint"
            android:textSize="12sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/usernameMTI" />

        <manoellribeiro.dev.martp.core.components.MartpTextInput
            android:id="@+id/emailMTI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:imeOptions="actionDone"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/usernameDescriptionTV"
            app:cornerRadius="10dp"
            app:label="@string/email_optional_hint"
            app:placeholder="@string/name_or_nickname_hint" />

        <TextView
            android:id="@+id/emailDescriptionTV"
            style="@style/Text.GraySubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingMultiplier="0.9"
            android:text="@string/email_not_mandatory_hint"
            android:textSize="12sp"
            android:textStyle="italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emailMTI" />

        <ProgressBar
            android:id="@+id/loadingIndicatorPB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:theme="@style/Theme.GenerateMapArts.ProgressBarTheme"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/digitalExhibitionTV" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="4dp"
            android:background="@drawable/background_digital_exhibition"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/background_live_indicator"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_rounded_globe"
                    app:tint="@color/yellow"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/yellow"
                    android:layout_marginStart="8dp"
                    android:textAllCaps="true"
                    android:text="@string/live"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/nunito_medium"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/galleryTV"
                style="@style/Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/white"
                android:text="@string/visit_digital_exhibition"
                android:textSize="16sp" />

            <TextView
                style="@style/Text.GraySubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explore_community_artworks"
                android:textSize="14sp"
                android:textColor="@color/light_l1"
                android:visibility="visible"
                android:lineSpacingMultiplier="0.8"/>

            <manoellribeiro.dev.martp.core.components.MartpButton
                android:id="@+id/openInBrowserMB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/open_in_browser"
                android:layout_marginTop="8dp"
                app:buttonBackgroundColor="@color/yellow"
                app:fontAndIconColor="@color/black"
                app:startIcon="@drawable/ic_open_in_browser"
                style="@style/MartpButton.Primary"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>